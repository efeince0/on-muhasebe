@model ErrorViewModel

@{
    ViewData["Title"] = "Hata";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <h3 class="mb-3">Bir şeyler ters gitti</h3>

        <p class="text-muted">
            İsteğiniz işlenirken beklenmeyen bir hata oluştu. Sayfayı yenilemeyi
            deneyebilir ya da ana sayfaya dönebilirsiniz. Hata tekrarlıyorsa
            aşağıdaki numarayı sistem sorumlusuna iletin.
        </p>

        @* Istek numarasi log kayitlariyla eslestirme icin; kullaniciya teknik ayrinti gosterilmez. *@
        @if (Model?.ShowRequestId == true)
        {
            <p class="mb-4">
                <span class="text-muted small">İstek numarası:</span>
                <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya dön</a>

    </div>
</div>
