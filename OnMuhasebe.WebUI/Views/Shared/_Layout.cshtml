<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ön Muhasebe</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnMuhasebe.WebUI.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Ön Muhasebe</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            @* Menu gizleme yalnizca gorunurluk icindir; yetki kontrolu sunucuda yapilir. *@
                            @if (User.IzniVar(Modul.Cari, Islem.Goruntule))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Cari" asp-action="Liste">Cariler</a>
                                </li>
                            }
                            @if (User.IzniVar(Modul.CariIslem, Islem.Goruntule))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="CariIslem" asp-action="Liste">Tahsilat / Ödeme</a>
                                </li>
                            }
                            @if (User.IzniVar(Modul.Stok, Islem.Goruntule))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Stok" asp-action="Liste">Stoklar</a>
                                </li>
                            }
                            @if (User.IzniVar(Modul.Fatura, Islem.Goruntule))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Fatura" asp-action="Liste">Faturalar</a>
                                </li>
                            }
                            @if (User.IzniVar(Modul.Kullanici, Islem.Goruntule))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Kullanici" asp-action="Liste">Kullanıcılar</a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="nav-link text-muted">@User.FindFirst("AdSoyad")?.Value</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">Çıkış</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Basarili"] != null)
            {
                <div class="alert alert-success">@TempData["Basarili"]</div>
            }
            @if (TempData["Hata"] != null)
            {
                <div class="alert alert-danger">@TempData["Hata"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Ön Muhasebe
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
