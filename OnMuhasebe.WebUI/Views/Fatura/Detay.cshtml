@model FaturaDetayViewModel

@{
    ViewData["Title"] = $"Fatura {Model.FaturaNo}";
    var alisMi = Model.FaturaTipi == FaturaTipi.Alis;
}

@* Razor'da @media Razor ifadesi sanilir; CSS'e gecmesi icin @@media yazilir. *@
<style>
    @@media print {
        /* Menu, butonlar ve alt bilgi kagida basilmaz. */
        header, footer, .yazdirma-disi { display: none !important; }

        /* Ekranda okunakli olan gri tonlar yazicida soluk cikiyor. */
        body { background: #fff; }
        .fatura-kutu { border: 1px solid #000 !important; }
        a { text-decoration: none; color: #000; }
    }
</style>

<div class="d-flex justify-content-between align-items-start mb-4 yazdirma-disi">
    <div>
        <h3 class="mb-1">
            @(alisMi ? "Alış Faturası" : "Satış Faturası")
            @if (!Model.Aktif)
            {
                <span class="badge text-bg-secondary align-middle">İptal</span>
            }
        </h3>
        <span class="text-muted"><code>@Model.FaturaNo</code> · @Model.Tarih.ToString("dd.MM.yyyy")</span>
    </div>

    <div class="text-nowrap">
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">Yazdır</button>

        @if (User.IzniVar(Modul.Fatura, Islem.Guncelle))
        {
            <a asp-action="Guncelle" asp-route-id="@Model.Id" class="btn btn-outline-primary">Düzenle</a>
        }

        @if (Model.Aktif && User.IzniVar(Modul.Fatura, Islem.Sil))
        {
            <form asp-action="PasifeAl" method="post" class="d-inline"
                  onsubmit="return confirm('Fatura iptal edilecek; stok ve cari hareketleri geri alınacak. Onaylıyor musunuz?');">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger">İptal Et</button>
            </form>
        }

        <a asp-action="Liste" class="btn btn-outline-secondary">Listeye dön</a>
    </div>
</div>

@* --- YAZDIRILAN BÖLÜM --- *@
<div class="fatura-kutu border rounded p-4">

    <div class="row mb-4">
        <div class="col-6">
            <div class="fs-5 fw-semibold">@(alisMi ? "ALIŞ FATURASI" : "SATIŞ FATURASI")</div>
            <div class="text-muted small">Ön Muhasebe Yönetim Sistemi</div>
        </div>
        <div class="col-6 text-end">
            <div><span class="text-muted small">Fatura No:</span> <b>@Model.FaturaNo</b></div>
            <div><span class="text-muted small">Tarih:</span> @Model.Tarih.ToString("dd.MM.yyyy")</div>
            @if (!Model.Aktif)
            {
                <div class="text-danger fw-semibold">İPTAL EDİLMİŞTİR</div>
            }
        </div>
    </div>

    <div class="border rounded p-3 mb-4">
        <div class="text-muted small mb-1">@(alisMi ? "Tedarikçi" : "Müşteri")</div>
        <div class="fw-semibold">@Model.Unvan</div>
        <div class="small text-muted">
            <code>@Model.CariKodu</code>
            @if (!string.IsNullOrWhiteSpace(Model.VergiDairesi) || !string.IsNullOrWhiteSpace(Model.VergiNo))
            {
                <text> · @Model.VergiDairesi @Model.VergiNo</text>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Telefon))
            {
                <text> · @Model.Telefon</text>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Adres))
        {
            <div class="small text-muted">@Model.Adres</div>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:40px">#</th>
                    <th>Ürün</th>
                    <th class="text-end">Miktar</th>
                    <th class="text-end">Birim Fiyat</th>
                    <th class="text-end">Tutar</th>
                    <th class="text-end">KDV</th>
                    <th class="text-end">Toplam</th>
                </tr>
            </thead>
            <tbody>
            @{ var sira = 1; }
            @foreach (var satir in Model.Satirlar)
            {
                <tr>
                    <td class="text-muted">@sira</td>
                    <td>
                        @satir.StokAdi
                        <div class="text-muted small"><code>@satir.StokKodu</code></div>
                    </td>
                    <td class="text-end">@satir.Miktar.ToString("N3") <span class="text-muted small">@satir.Birim</span></td>
                    <td class="text-end">@satir.BirimFiyat.ToString("N2")</td>
                    <td class="text-end">@satir.SatirTutari.ToString("N2")</td>
                    <td class="text-end">
                        @satir.KdvTutari.ToString("N2")
                        <div class="text-muted small">%@satir.KdvOrani.ToString("N0")</div>
                    </td>
                    <td class="text-end fw-semibold">@satir.ToplamTutar.ToString("N2")</td>
                </tr>
                sira++;
            }
            </tbody>
        </table>
    </div>

    <div class="row justify-content-end">
        <div class="col-md-5">
            <table class="table table-sm mb-0">
                <tr>
                    <th class="text-muted fw-normal">Ara Toplam</th>
                    <td class="text-end">@Model.AraToplam.ToString("N2") ₺</td>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">Toplam KDV</th>
                    <td class="text-end">@Model.ToplamKdv.ToString("N2") ₺</td>
                </tr>
                <tr class="table-light">
                    <th>Genel Toplam</th>
                    <td class="text-end fw-semibold fs-5">@Model.GenelToplam.ToString("N2") ₺</td>
                </tr>
            </table>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Aciklama))
    {
        <div class="mt-3">
            <div class="text-muted small">Açıklama</div>
            <div>@Model.Aciklama</div>
        </div>
    }

    @* Fatura guncellenebiliyor; kimin ne zaman dokundugu belgenin uzerinde dursun. *@
    <div class="mt-4 pt-3 border-top text-muted small">
        Kayıt: @Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")
        @if (!string.IsNullOrWhiteSpace(Model.OlusturanAdi))
        {
            <text> — @Model.OlusturanAdi</text>
        }

        @if (Model.GuncellemeTarihi.HasValue)
        {
            <text> · Son güncelleme: @Model.GuncellemeTarihi.Value.ToString("dd.MM.yyyy HH:mm")</text>
            @if (!string.IsNullOrWhiteSpace(Model.GuncelleyenAdi))
            {
                <text> — @Model.GuncelleyenAdi</text>
            }
        }
    </div>

</div>

<p class="text-muted small mt-3 yazdirma-disi">
    Yazdır düğmesi tarayıcının yazdırma penceresini açar; menü ve düğmeler çıktıda yer almaz.
</p>
