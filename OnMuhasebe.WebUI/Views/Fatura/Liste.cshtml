@model FaturaListeSonucu

@{
    ViewData["Title"] = "Faturalar";

    var faturaTipi  = ViewBag.FaturaTipi as FaturaTipi?;
    var cariId      = ViewBag.CariId as int?;
    var baslangic   = ViewBag.Baslangic as DateTime?;
    var bitis       = ViewBag.Bitis as DateTime?;
    var minTutar    = ViewBag.MinTutar as decimal?;
    var maxTutar    = ViewBag.MaxTutar as decimal?;
    var sadeceAktif = ViewBag.SadeceAktif as bool? ?? true;
    var sirala      = ViewBag.Sirala as string ?? "tarih";
    var yon         = ViewBag.Yon as string ?? "desc";
    var cariler     = ViewBag.Cariler as List<CariSecimViewModel> ?? [];

    // Bir kolona tiklandiginda: ayni kolonsa yonu ters cevir, farkliysa artan baslat.
    Func<string, string> yeniYon = kolon => (sirala == kolon && yon == "asc") ? "desc" : "asc";
    Func<string, string> ok      = kolon => sirala != kolon ? "" : (yon == "asc" ? " ▲" : " ▼");

    var bas = baslangic?.ToString("yyyy-MM-dd");
    var bit = bitis?.ToString("yyyy-MM-dd");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Faturalar</h3>

    @if (User.IzniVar(Modul.Fatura, Islem.Ekle))
    {
        <a asp-action="Ekle" class="btn btn-primary">Yeni Fatura</a>
    }
</div>

@* method="get": suzgec degerleri adres cubugunda kalir, sayfa paylasilabilir olur. *@
<form asp-action="Liste" method="get" class="row g-2 mb-4">
    <input type="hidden" name="sirala" value="@sirala" />
    <input type="hidden" name="yon" value="@yon" />

    <div class="col-md-2">
        <select name="faturaTipi" class="form-select">
            <option value="">Tüm türler</option>
            <option value="@FaturaTipi.Alis" selected="@(faturaTipi == FaturaTipi.Alis)">Alış</option>
            <option value="@FaturaTipi.Satis" selected="@(faturaTipi == FaturaTipi.Satis)">Satış</option>
        </select>
    </div>

    <div class="col-md-4">
        <select name="cariId" class="form-select">
            <option value="">Tüm cariler</option>
            @foreach (var cari in cariler)
            {
                <option value="@cari.Id" selected="@(cariId == cari.Id)">@cari.Etiket</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <input type="date" name="baslangic" class="form-control" value="@bas" title="Başlangıç tarihi" />
    </div>

    <div class="col-md-2">
        <input type="date" name="bitis" class="form-control" value="@bit" title="Bitiş tarihi" />
    </div>

    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary flex-fill">Filtrele</button>
        <a asp-action="Liste" class="btn btn-outline-secondary">Temizle</a>
    </div>

    <div class="col-md-2">
        <input name="minTutar" value="@(minTutar?.ToString("N2"))" class="form-control" placeholder="En az tutar" />
    </div>

    <div class="col-md-2">
        <input name="maxTutar" value="@(maxTutar?.ToString("N2"))" class="form-control" placeholder="En çok tutar" />
    </div>

    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check">
            @* Isaretlenmemis onay kutusu hicbir sey gondermez; gizli alan "false" degerini garantiler. *@
            <input type="hidden" name="sadeceAktif" value="false" />
            <input type="checkbox" name="sadeceAktif" value="true" id="sadeceAktif"
                   class="form-check-input" @(sadeceAktif ? "checked" : "") />
            <label for="sadeceAktif" class="form-check-label small">Sadece aktif faturalar</label>
        </div>
    </div>
</form>

@if (Model.ToplamKayit == 0)
{
    <div class="text-center border rounded py-5">
        <p class="text-muted mb-3">Bu filtreye uyan fatura bulunamadı.</p>
        @if (User.IzniVar(Modul.Fatura, Islem.Ekle))
        {
            <a asp-action="Ekle" class="btn btn-primary">İlk faturayı kes</a>
        }
    </div>
}
else
{
    @* Toplamlar sayfaya degil, suzgecin tamamina aittir. *@
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="border rounded p-3">
                <div class="text-muted small">Toplam Alış</div>
                <div class="fs-5 text-danger">@Model.ToplamAlis.ToString("N2") ₺</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="border rounded p-3">
                <div class="text-muted small">Toplam Satış</div>
                <div class="fs-5 text-success">@Model.ToplamSatis.ToString("N2") ₺</div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>
                        <a class="text-decoration-none text-reset" asp-action="Liste"
                           asp-route-faturaTipi="@faturaTipi" asp-route-cariId="@cariId"
                           asp-route-baslangic="@bas" asp-route-bitis="@bit"
                           asp-route-minTutar="@minTutar" asp-route-maxTutar="@maxTutar"
                           asp-route-sadeceAktif="@sadeceAktif"
                           asp-route-sirala="tarih" asp-route-yon="@yeniYon("tarih")">Tarih@(ok("tarih"))</a>
                    </th>
                    <th>
                        <a class="text-decoration-none text-reset" asp-action="Liste"
                           asp-route-faturaTipi="@faturaTipi" asp-route-cariId="@cariId"
                           asp-route-baslangic="@bas" asp-route-bitis="@bit"
                           asp-route-minTutar="@minTutar" asp-route-maxTutar="@maxTutar"
                           asp-route-sadeceAktif="@sadeceAktif"
                           asp-route-sirala="no" asp-route-yon="@yeniYon("no")">Fatura No@(ok("no"))</a>
                    </th>
                    <th>Tür</th>
                    <th>
                        <a class="text-decoration-none text-reset" asp-action="Liste"
                           asp-route-faturaTipi="@faturaTipi" asp-route-cariId="@cariId"
                           asp-route-baslangic="@bas" asp-route-bitis="@bit"
                           asp-route-minTutar="@minTutar" asp-route-maxTutar="@maxTutar"
                           asp-route-sadeceAktif="@sadeceAktif"
                           asp-route-sirala="cari" asp-route-yon="@yeniYon("cari")">Cari@(ok("cari"))</a>
                    </th>
                    <th class="text-end">Satır</th>
                    <th class="text-end">Ara Toplam</th>
                    <th class="text-end">KDV</th>
                    <th class="text-end">
                        <a class="text-decoration-none text-reset" asp-action="Liste"
                           asp-route-faturaTipi="@faturaTipi" asp-route-cariId="@cariId"
                           asp-route-baslangic="@bas" asp-route-bitis="@bit"
                           asp-route-minTutar="@minTutar" asp-route-maxTutar="@maxTutar"
                           asp-route-sadeceAktif="@sadeceAktif"
                           asp-route-sirala="tutar" asp-route-yon="@yeniYon("tutar")">Genel Toplam@(ok("tutar"))</a>
                    </th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var fatura in Model.Kayitlar)
            {
                <tr class="@(fatura.Aktif ? "" : "text-muted")">
                    <td>@fatura.Tarih.ToString("dd.MM.yyyy")</td>
                    <td><code>@fatura.FaturaNo</code></td>
                    <td>
                        @if (fatura.FaturaTipi == FaturaTipi.Alis)
                        {
                            <span class="badge text-bg-warning">Alış</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Satış</span>
                        }
                        @if (!fatura.Aktif)
                        {
                            <span class="badge text-bg-secondary">İptal</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Cari" asp-action="Detay" asp-route-id="@fatura.CariId"
                           class="text-decoration-none">@fatura.Unvan</a>
                    </td>
                    <td class="text-end">@fatura.SatirSayisi</td>
                    <td class="text-end">@fatura.AraToplam.ToString("N2")</td>
                    <td class="text-end">@fatura.ToplamKdv.ToString("N2")</td>
                    <td class="text-end fw-semibold">@fatura.GenelToplam.ToString("N2") ₺</td>
                    <td class="text-end text-nowrap">
                        @* Butonlarin gizlenmesi gorgu kuralidir; asil koruma controller'daki [Yetki]. *@
                        @if (User.IzniVar(Modul.Fatura, Islem.Guncelle))
                        {
                            <a asp-action="Guncelle" asp-route-id="@fatura.Id"
                               class="btn btn-sm btn-outline-primary">Düzenle</a>
                        }

                        @if (fatura.Aktif && User.IzniVar(Modul.Fatura, Islem.Sil))
                        {
                            <form asp-action="PasifeAl" method="post" class="d-inline"
                                  onsubmit="return confirm('Fatura iptal edilecek; stok ve cari hareketleri geri alınacak. Onaylıyor musunuz?');">
                                <input type="hidden" name="id" value="@fatura.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">İptal Et</button>
                            </form>
                        }

                        @if (!fatura.Aktif && User.IzniVar(Modul.Fatura, Islem.Guncelle))
                        {
                            <form asp-action="AktifYap" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@fatura.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Geri Al</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <p class="text-muted small mb-0">
            Toplam @Model.ToplamKayit kayıt · Sayfa @Model.SayfaNo / @Model.ToplamSayfa
        </p>

        @if (Model.ToplamSayfa > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.OncekiVar ? "" : "disabled")">
                        <a class="page-link" asp-action="Liste"
                           asp-route-faturaTipi="@faturaTipi" asp-route-cariId="@cariId"
                           asp-route-baslangic="@bas" asp-route-bitis="@bit"
                           asp-route-minTutar="@minTutar" asp-route-maxTutar="@maxTutar"
                           asp-route-sadeceAktif="@sadeceAktif" asp-route-sirala="@sirala" asp-route-yon="@yon"
                           asp-route-sayfa="@(Model.SayfaNo - 1)">Önceki</a>
                    </li>

                    @for (var s = 1; s <= Model.ToplamSayfa; s++)
                    {
                        <li class="page-item @(s == Model.SayfaNo ? "active" : "")">
                            <a class="page-link" asp-action="Liste"
                               asp-route-faturaTipi="@faturaTipi" asp-route-cariId="@cariId"
                               asp-route-baslangic="@bas" asp-route-bitis="@bit"
                               asp-route-minTutar="@minTutar" asp-route-maxTutar="@maxTutar"
                               asp-route-sadeceAktif="@sadeceAktif" asp-route-sirala="@sirala" asp-route-yon="@yon"
                               asp-route-sayfa="@s">@s</a>
                        </li>
                    }

                    <li class="page-item @(Model.SonrakiVar ? "" : "disabled")">
                        <a class="page-link" asp-action="Liste"
                           asp-route-faturaTipi="@faturaTipi" asp-route-cariId="@cariId"
                           asp-route-baslangic="@bas" asp-route-bitis="@bit"
                           asp-route-minTutar="@minTutar" asp-route-maxTutar="@maxTutar"
                           asp-route-sadeceAktif="@sadeceAktif" asp-route-sirala="@sirala" asp-route-yon="@yon"
                           asp-route-sayfa="@(Model.SayfaNo + 1)">Sonraki</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
