@model SifreSifirlaViewModel

@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<div class="row justify-content-center">
  <div class="col-lg-5">

    <h3 class="mb-1">Şifre Sıfırla</h3>
    <p class="text-muted">
        <b>@Model.AdSoyad</b> · <code>@Model.KullaniciAdi</code>
    </p>

    <form asp-action="SifreSifirla" method="post">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="KullaniciAdi" />
        <input type="hidden" asp-for="AdSoyad" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="YeniSifre" class="form-label"></label>
            <input asp-for="YeniSifre" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="YeniSifre" class="text-danger small"></span>
            <div class="form-text">@SifreKurali.Mesaj</div>
        </div>

        <div class="mb-3">
            <label asp-for="YeniSifreTekrar" class="form-label"></label>
            <input asp-for="YeniSifreTekrar" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="YeniSifreTekrar" class="text-danger small"></span>
        </div>

        @* Yonetici sifirlamasinda eski sifre sorulmaz; zaten bilinmiyor olabilir. *@
        <div class="alert alert-light border small">
            Kullanıcının mevcut şifresi sorulmaz. Yeni şifreyi kendisine iletmeniz gerekir.
        </div>

        <button type="submit" class="btn btn-primary">Şifreyi Sıfırla</button>
        <a asp-action="Liste" class="btn btn-outline-secondary">Vazgeç</a>
    </form>

  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
