@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="mb-4">
    <h3 class="mb-1">Hoş geldiniz, @User.FindFirst("AdSoyad")?.Value</h3>
    <p class="text-muted mb-0">
        @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value rolüyle giriş yaptınız.
        Aşağıda yalnızca yetkiniz olan modüller görünür.
    </p>
</div>

<div class="row g-3">

    @if (User.IzniVar(Modul.Cari, Islem.Goruntule))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Cariler</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Müşteri ve tedarikçi kartları, güncel bakiyeler, hesap ekstresi.
                    </p>
                    <div>
                        <a asp-controller="Cari" asp-action="Liste" class="btn btn-sm btn-primary">Listeye git</a>
                        @if (User.IzniVar(Modul.Cari, Islem.Ekle))
                        {
                            <a asp-controller="Cari" asp-action="Ekle" class="btn btn-sm btn-outline-secondary">Yeni</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (User.IzniVar(Modul.CariIslem, Islem.Goruntule))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Tahsilat / Ödeme</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Cari hesaplara ait nakit hareketleri; makbuz kaydı ve dönem toplamları.
                    </p>
                    <div>
                        <a asp-controller="CariIslem" asp-action="Liste" class="btn btn-sm btn-primary">Listeye git</a>
                        @if (User.IzniVar(Modul.CariIslem, Islem.Ekle))
                        {
                            <a asp-controller="CariIslem" asp-action="Ekle" class="btn btn-sm btn-outline-secondary">Yeni</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (User.IzniVar(Modul.Stok, Islem.Goruntule))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Stoklar</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Ürün kartları, mevcut miktar, kritik seviye uyarısı ve stok değeri.
                    </p>
                    <div>
                        <a asp-controller="Stok" asp-action="Liste" class="btn btn-sm btn-primary">Listeye git</a>
                        @if (User.IzniVar(Modul.Stok, Islem.Ekle))
                        {
                            <a asp-controller="Stok" asp-action="Ekle" class="btn btn-sm btn-outline-secondary">Yeni</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (User.IzniVar(Modul.StokHareket, Islem.Goruntule))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Stok Hareketleri</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Fatura dışındaki giriş, çıkış ve sayım düzeltmeleri.
                    </p>
                    <div>
                        <a asp-controller="StokHareket" asp-action="Liste" class="btn btn-sm btn-primary">Listeye git</a>
                        @if (User.IzniVar(Modul.StokHareket, Islem.Ekle))
                        {
                            <a asp-controller="StokHareket" asp-action="Ekle" class="btn btn-sm btn-outline-secondary">Yeni</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (User.IzniVar(Modul.Fatura, Islem.Goruntule))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Faturalar</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Alış ve satış faturaları; stok ve cari bakiyeye doğrudan yansır.
                    </p>
                    <div>
                        <a asp-controller="Fatura" asp-action="Liste" class="btn btn-sm btn-primary">Listeye git</a>
                        @if (User.IzniVar(Modul.Fatura, Islem.Ekle))
                        {
                            <a asp-controller="Fatura" asp-action="Ekle" class="btn btn-sm btn-outline-secondary">Yeni</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (User.IzniVar(Modul.Kullanici, Islem.Goruntule))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Kullanıcılar</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Personel hesapları, rol atama ve şifre sıfırlama.
                    </p>
                    <div>
                        <a asp-controller="Kullanici" asp-action="Liste" class="btn btn-sm btn-primary">Listeye git</a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (User.IzniVar(Modul.Rol, Islem.Goruntule))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Roller ve Yetkiler</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Rol tanımları ve modül bazında izin matrisi.
                    </p>
                    <div>
                        <a asp-controller="Rol" asp-action="Liste" class="btn btn-sm btn-primary">Listeye git</a>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
